CONFIG_LOGLEVEL=8
CONFIG_LOG_VERBOSE=y
CONFIG_DEBUG=y
CONFIG_HIDE_MEMORY_INFO=n
CONFIG_RMM_ELF_ADJUST_BASE=0x201000
CONFIG_ATF_NO_PLATFORM_PARAM=n
CONFIG_BOOTARGS_OVERWRITE=" maxcpus=2"
CONFIG_RK3588_HW_DEBUG=n

# OpenCCA:
# RME reserve (ARM_DRAM_RME_RESERVE_BASE + SIZE) is until /* 512 MB */
# (0x20000000). So we place U-Boot Proper at 0x20000000
# Sample layout:
#  - U-BOOT CONFIG_TEXT_BASE: TF-A will jump there for BL33
#  - U-BOOT CONFIG_CUSTOM_SYS_INIT_SP_ADDR: Stack
#  - U-BOOT CONFIG_SYS_LOAD_ADDR: Default load addr for images (same as scriptaddr)
# see include/configs/rk3588_common.h
CONFIG_TEXT_BASE=0x20000000
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x23000000
CONFIG_SYS_LOAD_ADDR=0x24000000
